{
  "model_version": "petreid-resnet50-gem-arcface-v1.0.0",
  "embedding_dim": 512,
  "embedding_dtype": "float16",
  "l2_normalized": true,
  "input": {
    "color": "RGB",
    "resize": [224, 224],
    "resize_mode": "direct_resize",
